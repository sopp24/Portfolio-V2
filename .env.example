# The FRONTEND needs NO secret and NO environment variable: it is a static site on GitHub Pages.
# The only frontend setting is the public URL of the deployed Worker, placed in index.html:
#   <meta name="assistant-endpoint" content="https://side-a-shopkeeper.<your-subdomain>.workers.dev">
# Leave it empty to run in honest "catalogue mode" (local FAQ, no AI).
#
# Never commit real keys. Worker secrets are set with `npx wrangler secret put AI_API_KEY`
# (production) or in an untracked .dev.vars file (local, see .dev.vars.example).

# Worker configuration (non-secret, mirrored in wrangler.jsonc "vars"):
ALLOWED_ORIGINS=https://sopp24.github.io,http://localhost:8080
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
# AI_BASE_URL=            # optional, https only (OpenAI-compatible servers, proxies)
MAX_OUTPUT_TOKENS=450
RATE_LIMIT_PER_MINUTE=8
DAILY_REQUEST_BUDGET=1500
