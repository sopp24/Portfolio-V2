{
  // SIDE A shopkeeper backend. Deploy with `npx wrangler deploy` — see docs/BACKEND.md.
  // Secrets are NEVER listed here: run `npx wrangler secret put AI_API_KEY`.
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "side-a-shopkeeper",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "vars": {
    // Exact-match origins (no trailing slash). Keep only your real site in production.
    "ALLOWED_ORIGINS": "https://sopp24.github.io,http://localhost:8080",
    // "anthropic" (default) or "openai" (any OpenAI Chat Completions-compatible API, see AI_BASE_URL).
    "AI_PROVIDER": "anthropic",
    // Model identifier. Check the provider's current model list before changing it.
    "AI_MODEL": "claude-haiku-5-5",
    "MAX_OUTPUT_TOKENS": "450",
    "RATE_LIMIT_PER_MINUTE": "8",
    "DAILY_REQUEST_BUDGET": "1500"
  }
  // Optional bindings (add them only after creating the resources; see docs/BACKEND.md):
  // "kv_namespaces": [{ "binding": "BUDGET_KV", "id": "<your-kv-namespace-id>" }],
  // "unsafe": { "bindings": [{ "name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }] }
}
